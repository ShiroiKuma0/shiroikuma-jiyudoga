<?xml version="1.0" encoding="utf-8"?>
<!-- `shared/` is the one directory `shareFile` writes into; `diag/` holds the Diagnostics files
     (diag/Diag.kt) that its Share hands over. A share grants read access to exactly the files
     handed over, nothing else in the app's storage. -->
<paths>
  <cache-path
    name="shared"
    path="shared/" />
  <external-files-path
    name="diag"
    path="diag/" />
</paths>
