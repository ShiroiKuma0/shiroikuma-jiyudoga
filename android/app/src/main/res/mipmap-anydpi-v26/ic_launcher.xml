<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <!-- 7.25% inset per side = 85.5% of the stock size; the drawable itself is
         left alone because the splash screen (values-night-v31/v33) reuses it. -->
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="7.25%" />
    </foreground>
    <monochrome>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="7.25%" />
    </monochrome>
</adaptive-icon>
